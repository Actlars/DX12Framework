<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Item">
  <TemplateData>
    <Name>Slang Mesh Shader</Name>
    <Description>Slangで書くMesh Shaderファイルを作成します。</Description>
    <ProjectType>VC</ProjectType>
    <SortOrder>20</SortOrder>
    <DefaultName>NewMeshShader.slang</DefaultName>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.slang">SlangMeshShader.slang</ProjectItem>
  </TemplateContent>
</VSTemplate>