<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Item">
  <TemplateData>
    <Name>Slang Compute Shader</Name>
    <Description>Slangで書くCompute Shaderファイルを作成します。</Description>
    <ProjectType>VC</ProjectType>
    <SortOrder>10</SortOrder>
    <Icon>__TemplateIcon.ico</Icon>
    <DefaultName>NewComputeShader.slang</DefaultName>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.slang">SlangComputeShader.slang</ProjectItem>
  </TemplateContent>
</VSTemplate>